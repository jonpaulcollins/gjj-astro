---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
    { "@type": "ListItem", position: 2, name: "Memberships", item: site.domain + "/memberships" },
  ],
};

const plans = [
  {
    name: "Gold", popular: true, barClass: "from-yellow-400 to-yellow-600", underlineClass: "bg-yellow-500", borderHover: "hover:border-yellow-500/50",
    features: ["Unlimited Classes", "Gi & No-Gi Training", "Wrestling Included", "Weights Gym Included", "Best Value - Get Good, Fast!"],
  },
  {
    name: "Silver", popular: false, barClass: "from-gray-300 to-gray-500", underlineClass: "bg-gray-400", borderHover: "hover:border-gray-400/50",
    features: ["2 Classes Per Week", "Flexible Schedule", "Train Morning, Noon or Night", "Ideal For Hobbyists"],
  },
  {
    name: "Platinum", popular: false, barClass: "from-slate-500 to-slate-700", underlineClass: "bg-slate-500", borderHover: "hover:border-slate-500/50",
    features: ["Unlimited Classes", "Monthly Private Lesson Included", "Weights Gym Included", "Fastest Progress Possible"],
  },
  {
    name: "Kids Team", popular: false, barClass: "", solidBar: true, underlineClass: "bg-brand-red", borderHover: "hover:border-brand-red/50",
    features: ["Ages 5-15", "Up to 4 Training Sessions a Week", "Structured Curriculum", "Bully-Proofing your little ones"],
  },
];

const whyJoin = ["No Contracts", "No Annual Fees", "No Grading Fees", "Upgrade or Downgrade Anytime", "Welcoming Friendly Community", "Safe, Clean & Modern Facility", "Experienced & Qualified Black Belt Coaches", "Sessions, Morning Noon & Night", "Next to Rail & Bus Links + Free Parking"];

const different = [
  { icon: "🥋", text: "Beginner Friendly" },
  { icon: "🛡", text: "Safe Training Environment" },
  { icon: "🧠", text: "Modern Science-Based Coaching" },
  { icon: "🤝", text: "Supportive Community" },
];

const compareRows = [
  { feature: "Unlimited Training", gold: true, silver: false, platinum: true },
  { feature: "Private Lessons", gold: false, silver: false, platinum: true },
  { feature: "Weights Gym", gold: true, silver: false, platinum: true },
  { feature: "Classes Per Week", gold: "Unlimited", silver: "2", platinum: "Unlimited" },
];
---
<Layout
  title="Memberships & Pricing — Guildford Jiu Jitsu"
  description="Flexible BJJ memberships with no contracts or hidden fees. Start your martial arts journey today with unlimited training options."
  path="/memberships"
  schema={schema}
>
  <!-- HERO -->
  <section class="relative min-h-[80vh] flex flex-col text-center px-4 border-b border-white/5 overflow-hidden pt-32 pb-12">
    <div class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden bg-black">
      <iframe
        src="https://player.vimeo.com/video/1219201262?h=896ffff26e&background=1&autoplay=1&loop=1&muted=1"
        class="absolute top-1/2 left-1/2 w-[177.77vh] min-w-full h-[56.25vw] min-h-full -translate-x-1/2 -translate-y-1/2 opacity-40 pointer-events-none"
        frameborder="0"
        allow="autoplay; fullscreen"
        title="Guildford Jiu Jitsu memberships hero video"
      ></iframe>
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black"></div>
    </div>
    <div class="container relative z-10 mx-auto max-w-4xl flex flex-col flex-grow justify-between h-full">
      <div class="flex-grow flex flex-col justify-center mt-12">
        <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter mb-6 text-white drop-shadow-lg">Membership Options</h1>
        <p class="text-xl md:text-2xl font-body text-white/80 mb-2">Train Around Your Schedule.<br />Flexible Memberships from Just £65 per Month</p>
        <p class="text-base md:text-lg font-body text-white/60 mb-10">Children's memberships £55 per month</p>
        <div class="mt-auto pt-12">
          <a href="/#free-trial" class="inline-flex items-center justify-center gap-2 whitespace-nowrap h-11 bg-brand-red hover:bg-red-700 text-white font-bold uppercase tracking-widest px-10 transition-transform hover:scale-105">Book Free Trial</a>
        </div>
      </div>
      <div class="max-w-2xl mx-auto pt-10 pb-12">
        <p class="text-lg md:text-xl font-bold font-body text-white mb-2">Not sure which membership is right for you?</p>
        <p class="text-md md:text-lg text-white/80 font-body">Book a free trial and we'll recommend the best option after your first class.</p>
      </div>
    </div>
  </section>

  <!-- WHY JOIN -->
  <section class="py-20 bg-zinc-950 border-b border-white/5">
    <div class="mx-auto max-w-5xl px-4 md:px-8">
      <h2 class="text-2xl md:text-4xl font-black text-center uppercase tracking-tighter mb-12">Why Join Guildford Jiu Jitsu?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {whyJoin.map((w) => (
          <div class="flex items-center gap-4 bg-black p-6 border border-white/10 rounded-lg">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-brand-red flex-shrink-0"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            <span class="text-lg font-body text-white/90">{w}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT MAKES US DIFFERENT -->
  <section class="py-20 bg-black border-b border-white/5">
    <div class="mx-auto max-w-4xl px-4 md:px-8">
      <h2 class="text-2xl md:text-4xl font-black text-center uppercase tracking-tighter mb-12">What Makes Us Different?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {different.map((d) => (
          <div class="flex items-center gap-4 bg-zinc-950 p-8 border border-white/10 rounded-lg hover:border-brand-red/50 transition-colors">
            <span class="text-4xl flex-shrink-0">{d.icon}</span>
            <span class="text-xl font-body text-white/90">{d.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MEMBERSHIP PLANS -->
  <section class="py-24 bg-black border-b border-white/5">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <h2 class="text-2xl md:text-4xl font-black text-center uppercase tracking-tighter mb-12">Membership Plans</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-7xl mx-auto mb-16">
        {plans.map((p) => (
          <div class={`bg-zinc-950 border border-white/10 p-8 flex flex-col relative group ${p.borderHover} transition-colors`}>
            {p.solidBar ? (
              <div class="absolute top-0 left-0 w-full h-1 bg-brand-red"></div>
            ) : (
              <div class={`absolute top-0 left-0 w-full h-1 bg-gradient-to-r ${p.barClass}`}></div>
            )}
            {p.popular && (
              <div class="absolute -top-3 right-4 bg-brand-red text-white text-[10px] font-bold uppercase tracking-widest py-1 px-3">Most Popular</div>
            )}
            <h3 class="text-xl md:text-2xl font-black uppercase tracking-tighter text-white mb-2">{p.name}</h3>
            <div class={`w-12 h-1 ${p.underlineClass} mb-6`}></div>
            <ul class="space-y-4 mb-8 flex-grow">
              {p.features.map((f) => (
                <li class="flex items-start gap-3">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-brand-red flex-shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                  <span class="text-white/80 font-body text-base">{f}</span>
                </li>
              ))}
            </ul>
            <a href="/#free-trial" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm bg-brand-red hover:bg-red-700 text-white font-bold uppercase tracking-widest px-6 py-3 text-center transition-colors">Start Free Trial</a>
          </div>
        ))}
      </div>

      <!-- COMPARE PLANS -->
      <div class="max-w-3xl mx-auto">
        <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tighter mb-4 text-white text-center">Compare Plans</h3>

        <!-- Desktop / tablet table -->
        <div class="hidden md:block overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-white/10">
                <th class="py-4 px-6 text-white/60 font-bold uppercase tracking-widest text-sm">Feature</th>
                <th class="py-4 px-6 text-yellow-500 font-bold uppercase tracking-widest text-sm text-center">Gold</th>
                <th class="py-4 px-6 text-gray-400 font-bold uppercase tracking-widest text-sm text-center">Silver</th>
                <th class="py-4 px-6 text-slate-500 font-bold uppercase tracking-widest text-sm text-center">Platinum</th>
              </tr>
            </thead>
            <tbody class="text-white/80 font-body text-base">
              {compareRows.map((r) => (
                <tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
                  <td class="py-4 px-6">{r.feature}</td>
                  <td class="py-4 px-6 text-center text-xl">{r.gold === true ? <span class="text-brand-red">✓</span> : r.gold === false ? <span class="text-white/30">✗</span> : r.gold}</td>
                  <td class="py-4 px-6 text-center text-xl">{r.silver === true ? <span class="text-brand-red">✓</span> : r.silver === false ? <span class="text-white/30">✗</span> : r.silver}</td>
                  <td class="py-4 px-6 text-center text-xl">{r.platinum === true ? <span class="text-brand-red">✓</span> : r.platinum === false ? <span class="text-white/30">✗</span> : r.platinum}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Mobile: one stacked card per plan -->
        <div class="md:hidden space-y-4">
          {[
            { key: "gold", label: "Gold", color: "text-yellow-500", border: "border-yellow-500/30" },
            { key: "silver", label: "Silver", color: "text-gray-400", border: "border-gray-400/30" },
            { key: "platinum", label: "Platinum", color: "text-slate-500", border: "border-slate-500/30" },
          ].map((plan) => (
            <div class={`border ${plan.border} rounded-lg overflow-hidden`}>
              <div class="bg-white/5 py-3 px-4">
                <span class={`font-black uppercase tracking-widest text-sm ${plan.color}`}>{plan.label}</span>
              </div>
              <ul class="divide-y divide-white/5">
                {compareRows.map((r) => (
                  <li class="flex items-center justify-between py-3 px-4 text-sm">
                    <span class="text-white/70 font-body">{r.feature}</span>
                    <span class="font-bold text-white/90">
                      {r[plan.key] === true ? <span class="text-brand-red text-lg">✓</span> : r[plan.key] === false ? <span class="text-white/30 text-lg">✗</span> : r[plan.key]}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM PHOTO BANNER -->
  <section class="w-full border-b border-white/5">
    <img src="https://vibe.filesafe.space/1779794450101245883/attachments/835b3a55-fb50-449d-b711-25a8a21beecd.png" alt="Guildford Jiu Jitsu Team" class="w-full h-auto object-cover" loading="lazy" />
  </section>

  <!-- TESTIMONIALS -->
  <section class="py-20 bg-black overflow-hidden border-b border-white/5">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <h2 class="text-2xl md:text-4xl font-black text-center uppercase tracking-tighter mb-10">Trusted By Hundreds Of Local Members</h2>
      <script is:inline type="text/javascript" src="https://reputationhub.site/reputation/assets/review-widget.js"></script>
      <iframe
        class="lc_reviews_widget"
        src="https://reputationhub.site/reputation/widgets/review_widget/3lxJJ7cu1zHYhHZZrgTx?widgetId=6a6f866a7e4a8ca09931e9a8"
        frameborder="0"
        scrolling="no"
        style="min-width: 100%; width: 100%;"
      ></iframe>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-24 bg-black text-center">
    <div class="mx-auto max-w-2xl px-4">
      <h2 class="text-2xl md:text-4xl font-black uppercase tracking-tighter mb-8 text-white">Start Your Free Trial Today</h2>
      <a href="/#free-trial" class="inline-flex items-center justify-center gap-2 whitespace-nowrap bg-brand-red hover:bg-red-700 text-white font-bold uppercase tracking-widest px-10 py-4 transition-transform hover:scale-105">Book Free Class</a>
    </div>
  </section>
</Layout>
