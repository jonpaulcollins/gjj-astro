---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { googleReviews } from "../data/testimonials";

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
    { "@type": "ListItem", position: 2, name: "Memberships", item: site.domain + "/memberships" },
  ],
};

const plans = [
  { name: "SILVER", popular: false, features: ["2 Classes Per Week", "Flexible Schedule", "Train Morning, Noon or Night", "Ideal For Hobbyists"] },
  { name: "GOLD", popular: true, features: ["Unlimited Classes", "Gi & No-Gi Training", "Wrestling Included", "Weights Gym Included", "Best Value - Get Good, Fast!"] },
  { name: "PLATINUM", popular: false, features: ["Unlimited Classes", "Monthly Private Lesson Included", "Weights Gym Included", "Fastest Progress Possible"] },
  { name: "KIDS TEAM", popular: false, features: ["Ages 5-15", "Up to 4 Training Sessions a Week", "Structured Curriculum", "Bully-Proofing Your Little Ones"] },
];

const whyJoin = ["No Contracts", "No Annual Fees", "No Grading Fees", "Upgrade or Downgrade Anytime", "Friendly Community", "Dedicated, Modern Facility", "Experienced & Qualified Coaches", "Sessions, Morning Noon & Night"];

const compareRows = [
  { feature: "Unlimited Training", gold: true, silver: false, platinum: true },
  { feature: "Private Lessons", gold: false, silver: false, platinum: true },
  { feature: "Weights Gym", gold: true, silver: false, platinum: true },
];
---
<Layout
  title="Memberships & Pricing — Guildford Jiu Jitsu"
  description="Flexible BJJ memberships with no contracts or hidden fees. Start your martial arts journey today with unlimited training options."
  path="/memberships"
  schema={schema}
>
  <section class="bg-black py-16 text-center">
    <div class="mx-auto max-w-2xl px-4">
      <h1 class="text-4xl md:text-5xl font-black mb-4">MEMBERSHIP OPTIONS</h1>
      <p class="text-white/70 mb-2">Train Around Your Schedule.</p>
      <p class="text-2xl font-black text-brand-red mb-1">Flexible Memberships from Just £65 per Month</p>
      <p class="text-white/60 text-sm mb-6">Children's memberships £55 per month</p>
      <a href="/#free-trial" class="inline-block bg-brand-red px-6 py-3 font-bold rounded hover:bg-red-700">BOOK FREE TRIAL</a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 md:px-8 py-16">
    <h2 class="text-2xl md:text-3xl font-black text-center mb-10">MEMBERSHIP PLANS</h2>
    <div class="grid md:grid-cols-4 gap-6">
      {plans.map((p) => (
        <div class={`bg-white/5 border rounded-xl p-6 relative ${p.popular ? "border-brand-red" : "border-white/10"}`}>
          {p.popular && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand-red text-xs font-bold px-3 py-1 rounded-full">MOST POPULAR</span>
          )}
          <h3 class="font-black text-xl mb-4 mt-2">{p.name}</h3>
          <ul class="space-y-2 text-sm text-white/80 mb-6">
            {p.features.map((f) => <li>• {f}</li>)}
          </ul>
          <a href="/#free-trial" class="block text-center bg-brand-red font-bold rounded py-2 hover:bg-red-700">START FREE TRIAL</a>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-white/5 py-16">
    <div class="mx-auto max-w-3xl px-4 md:px-8">
      <h2 class="text-2xl md:text-3xl font-black text-center mb-8">COMPARE PLANS</h2>
      <table class="w-full text-sm text-center border-collapse">
        <thead>
          <tr class="border-b border-white/20">
            <th class="text-left py-3">FEATURE</th>
            <th class="py-3">GOLD</th>
            <th class="py-3">SILVER</th>
            <th class="py-3">PLATINUM</th>
          </tr>
        </thead>
        <tbody>
          {compareRows.map((r) => (
            <tr class="border-b border-white/10">
              <td class="text-left py-3">{r.feature}</td>
              <td class="py-3">{r.gold ? "✓" : "✗"}</td>
              <td class="py-3">{r.silver ? "✓" : "✗"}</td>
              <td class="py-3">{r.platinum ? "✓" : "✗"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 md:px-8 py-16">
    <h2 class="text-2xl md:text-3xl font-black text-center mb-8">WHY JOIN GUILDFORD JIU JITSU?</h2>
    <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-4 text-center text-sm text-white/80">
      {whyJoin.map((w) => <div class="bg-white/5 rounded-lg p-4">{w}</div>)}
    </div>
  </section>

  <section class="bg-white/5 py-16">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <h2 class="text-2xl md:text-3xl font-black text-center mb-2">TRUSTED BY HUNDREDS OF LOCAL MEMBERS</h2>
      <p class="text-center font-bold mb-10">★★★★★ 5.0 (214 reviews)</p>
      <div class="grid md:grid-cols-4 gap-6">
        {googleReviews.slice(0, 4).map((r) => (
          <div class="bg-black rounded-lg p-5">
            <p class="font-bold mb-1">{r.name}</p>
            <p class="text-xs text-white/50 mb-3">{r.time}</p>
            <p class="text-sm text-white/80">&ldquo;{r.text}&rdquo;</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 text-center">
    <h2 class="text-2xl md:text-3xl font-black mb-6">START YOUR FREE TRIAL TODAY</h2>
    <a href="/#free-trial" class="inline-block bg-brand-red px-8 py-3 font-bold rounded hover:bg-red-700">BOOK FREE CLASS</a>
  </section>
</Layout>
