---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
    { "@type": "ListItem", position: 2, name: "Classes", item: site.domain + "/classes" },
  ],
};

const programmes = [
  {
    slug: "foundations",
    title: "Foundations",
    image: "https://vibe.filesafe.space/1779794450101245883/attachments/c2f0e17b-c0a8-41e5-9c2a-47f24d289adc.png",
    pretitle: "Beginners Welcome",
    desc: "Foundations Classes provide the starting-point for almost every Guildford Jiu Jitsu Journey. Our curriculum is a fully structured - bottom-up system, not just random techniques, or the lazy \"move of the day\", but an actual progression of Real Grappling Skills that deliberately develop your game layer by layer, skill-upon-skill.",
    bullets: ["Structured for beginners to seasoned competitors", "Systematic curriculum, not just random techniques", "Gi & No-Gi training", "6:30pm Mon-Fri, Midday Mon & Wed"],
    cta: "Book Your Beginners Free Trial",
  },
  {
    slug: "all-levels",
    title: "All Levels",
    image: "https://vibe.filesafe.space/1779794450101245883/attachments/34182fe3-2c60-4c5d-adaa-bb7224dd4c9f.png",
    pretitle: "Push Your Skill-Set",
    desc: "All Levels classes are designed to teach the demands of competition, sharpen existing abilities, and reach a higher level of performance by combining the skills of grappling with a deeper understanding of wrestling and leg-locking. Whether you're brand new or a seasoned competitor, the No-Gi All Levels class meets you where you are and will push your skill-set further, faster.",
    bullets: [
      "We use the constraints-led approach (CLA), meaning no time is wasted drilling for the sake of drilling. Instead, more focus is on game-based, adaptive problem solving - with time spent exploring real grappling situations.",
      "Structured for beginners to seasoned competitors",
      "Systematic curriculum, competition-tested",
      "No-Gi training with Leg-locks & Wrestling",
      "7:45pm Mon, Tues & Thurs",
    ],
    cta: "Try NoGi For Free!",
  },
  {
    slug: "womens",
    title: "Women's Classes",
    image: "https://vibe.filesafe.space/1779794450101245883/attachments/b177057c-e6dc-43e3-aa0a-1540b9ff84c6.png",
    pretitle: "Women's Only",
    desc: "A strong contingent of women training at a BJJ gym is universally recognized as an excellent sign. It indicates a welcoming, safe, and ego-checked environment. So, with nearly 50 female members, join the UK's biggest Women's Team and build physical confidence, fitness, and energy in our supportive community. Sunday mornings it's Women Only in the Gym from 10:30am and you'll also find that the Ladies out in force in our weekday Foundations Classes from 6:30pm - especially Tuesdays & Thursdays!",
    bullets: ["Women Only Class 10:30am Sun", "Feel Empowered by Jiu Jitsu", "UK's Biggest & Most Welcoming Women's Team"],
    cta: "Book Your Women's Free Trial",
  },
  {
    slug: "kids",
    title: "Kids Classes",
    image: "https://vibe.filesafe.space/1779794450101245883/attachments/46aa958a-3293-4929-b439-8c12cd358cdb.png",
    pretitle: "(5-15yrs)",
    desc: "Help your child build self-confidence, focus and friendships in a safe, fun and supportive environment. We know that a Play-Based approach is the most effective way for children (and adults) to learn, so our youngsters won't waste time running laps of the gym, they won't sit around waiting for their turn & they won't daydream the class away - while the coach delivers long lectures.",
    bullets: ["Juniors (ages 5-10) & Teens (ages 10-15)", '"Bully-Proof" your child with real resilience, confidence & self-defence skills', "4 classes a week from £55/month = far better value than a once-weekly activity"],
    cta: "Book Your Child's Free Trial",
  },
  {
    slug: "privates",
    title: "Private Tuition",
    image: "https://vibe.filesafe.space/1779794450101245883/attachments/0aa2ce09-2bd0-4d7a-ad59-9a8a3a6f207c.png",
    pretitle: "One-On-One Coaching",
    desc: "Nothing personalizes your Jiu Jitsu Journey more than private instruction. Work one-on-one with Head Coach Jon and his Black Belt instructors to focus on exactly what you need: specific positions, competition prep, or just getting unstuck. By appointment only.",
    bullets: ["With Jon or his instructors", "Any focus area, skill-set or position", "Competition prep available", "Contact us to schedule"],
    cta: "Enquire About Privates",
  },
  {
    slug: "sparring",
    title: "Sparring Open Sessions",
    image: "https://vibe.filesafe.space/1779794450101245883/attachments/97677a04-f6f0-4839-9fca-357ae6af92ed.png",
    pretitle: "Open Sessions",
    desc: "In BJJ, Open Sparring is the proving ground. Show up, warm up, and put your skills to the test in our safe, structured environment by rolling with different partners of all levels. Undoubtedly, the fastest way to accelerate your development.",
    bullets: ["No instruction, open rolling", "Fri & Sun Midday, Sat 11am", "All levels welcome"],
    cta: "Join a Sparring Session",
  },
  {
    slug: "visitors",
    title: "Visitors",
    image: "https://vibe.filesafe.space/1779794450101245883/attachments/8504977d-c652-4669-b1fa-a970fee900aa.png",
    pretitle: "Drop-Ins Welcome",
    desc: "Visiting from out of town? Drop-ins are always welcome at Guildford Jiu Jitsu.",
    bullets: ["Per Class £15", "Day Pass £20", "Week Pass for Unlimited Training £50"],
    cta: "Contact Us to Drop In",
  },
];
---
<Layout
  title="BJJ Programmes & Classes — Guildford Jiu Jitsu"
  description="Explore our Brazilian Jiu Jitsu programmes in Guildford. From absolute beginners to advanced No-Gi, Kids BJJ and Women's only classes."
  path="/classes"
  schema={schema}
>
  <section class="bg-black py-16 text-center">
    <div class="mx-auto max-w-3xl px-4">
      <p class="text-brand-red font-bold tracking-[0.3em] uppercase text-xs mb-4">Guildford Jiu Jitsu – Surrey, UK</p>
      <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter leading-none mb-8">Training<br />Programmes</h1>
      <p class="text-white/70 text-lg">
        One Place. Six Programmes. Built around One Idea:<br /><span class="italic">&ldquo;Fun &amp; Foundation First!&rdquo;</span>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 md:px-8 pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-16">
      {programmes.map((p) => (
        <div
          class="programme-card-clickable group relative overflow-hidden bg-black border border-white/5 h-full cursor-pointer"
          role="button"
          tabindex="0"
          aria-label={`View details for ${p.title}`}
          data-slug={p.slug}
          data-image={p.image}
          data-pretitle={p.pretitle}
          data-title={p.title}
          data-desc={p.desc}
          data-bullets={JSON.stringify(p.bullets)}
          data-cta={p.cta}
        >
          <img src={p.image} alt={p.title} class="w-full h-full aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-110 opacity-60 group-hover:opacity-70" loading="lazy" />
          <div class="absolute inset-0 flex flex-col items-center justify-center p-6 bg-black/40 group-hover:bg-black/20 transition-colors">
            <h4 class="text-xl md:text-2xl font-black uppercase tracking-tighter text-center mb-6 group-hover:scale-110 transition-transform">{p.title}</h4>
            <span class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm h-11 border border-white/40 hover:bg-white hover:text-black text-white font-bold uppercase tracking-widest px-8 transition-colors">View Details</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- PROGRAMME DETAIL MODAL -->
  <div id="programme-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4" role="dialog" aria-modal="true">
    <div class="relative w-full max-w-lg bg-zinc-950 max-h-[90vh] overflow-hidden">
      <button id="programme-modal-close" type="button" class="absolute top-4 right-4 p-2 bg-black/50 hover:bg-black/80 rounded-full text-white transition-colors z-10" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      <div class="overflow-y-auto w-full max-h-[90vh]">
        <div class="relative">
          <img id="programme-modal-img" src="" alt="" class="w-full h-64 md:h-80 object-cover object-top" />
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>
        </div>
        <div class="p-8 pt-0 relative z-10 -mt-12 md:-mt-16">
          <p id="programme-modal-pretitle" class="text-brand-red font-bold tracking-[0.2em] uppercase text-xs mb-2"></p>
          <h2 id="programme-modal-title" class="text-2xl md:text-4xl font-black uppercase tracking-tighter mb-4"></h2>
          <div class="space-y-6 text-white/80">
            <p id="programme-modal-desc" class="leading-relaxed"></p>
            <ul id="programme-modal-bullets" class="space-y-3"></ul>
          </div>
          <a href="/#free-trial" id="programme-modal-cta" class="mt-8 inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm h-11 bg-brand-red hover:bg-red-700 text-white font-bold uppercase tracking-widest px-8 w-full transition-colors"></a>
        </div>
      </div>
    </div>
  </div>

  <section class="py-16 text-center">
    <a href="/#free-trial" class="inline-block bg-brand-red px-8 py-3 font-bold rounded hover:bg-red-700 transition-transform hover:scale-105">CLAIM YOUR FREE TRIAL</a>
  </section>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const modal = document.getElementById("programme-modal");
      const img = document.getElementById("programme-modal-img");
      const pretitle = document.getElementById("programme-modal-pretitle");
      const title = document.getElementById("programme-modal-title");
      const desc = document.getElementById("programme-modal-desc");
      const bulletsEl = document.getElementById("programme-modal-bullets");
      const cta = document.getElementById("programme-modal-cta");
      const closeBtn = document.getElementById("programme-modal-close");

      function openModal(card) {
        img.src = card.dataset.image;
        img.alt = card.dataset.title;
        pretitle.textContent = card.dataset.pretitle;
        title.textContent = card.dataset.title;
        desc.textContent = card.dataset.desc;
        const bullets = JSON.parse(card.dataset.bullets || "[]");
        bulletsEl.innerHTML = "";
        bullets.forEach((b) => {
          const li = document.createElement("li");
          li.className = "flex items-start gap-3";
          li.innerHTML = '<div class="w-2 h-2 bg-brand-red mt-2 rounded-sm shrink-0"></div><span>' + b + "</span>";
          bulletsEl.appendChild(li);
        });
        cta.textContent = card.dataset.cta;
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
      }

      function closeModal() {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        document.body.style.overflow = "";
      }

      document.querySelectorAll(".programme-card-clickable").forEach((card) => {
        card.addEventListener("click", () => openModal(card));
        card.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openModal(card); }
        });
      });

      closeBtn.addEventListener("click", closeModal);
      modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });
    });
  </script>
</Layout>
