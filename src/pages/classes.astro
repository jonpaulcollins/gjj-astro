---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { programmes } from "../data/programmes";

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
    { "@type": "ListItem", position: 2, name: "Classes", item: site.domain + "/classes" },
  ],
};

const cards = [
  "Foundations", "All Levels", "Women's Classes", "Kids Classes",
  "Private Tuition", "Sparring Open Sessions", "Visitors",
];
---
<Layout
  title="BJJ Programmes & Classes — Guildford Jiu Jitsu"
  description="Explore our Brazilian Jiu Jitsu programmes in Guildford. From absolute beginners to advanced No-Gi, Kids BJJ and Women's only classes."
  path="/classes"
  schema={schema}
>
  <section class="bg-black py-16 text-center">
    <div class="mx-auto max-w-3xl px-4">
      <p class="text-brand-red font-bold tracking-widest mb-2">GUILDFORD JIU JITSU – SURREY, UK</p>
      <h1 class="text-4xl md:text-5xl font-black mb-4">TRAINING PROGRAMMES</h1>
      <p class="text-white/70">
        One Place. Six Programmes. Built around one idea: <span class="italic">&ldquo;Fun &amp; Foundation First!&rdquo;</span>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 md:px-8 py-16 grid sm:grid-cols-2 md:grid-cols-4 gap-6">
    {cards.map((c) => (
      <div class="bg-white/5 border border-white/10 rounded-xl p-6 text-center">
        <h3 class="font-black mb-4">{c.toUpperCase()}</h3>
        <a href="/timetable" class="text-brand-red text-sm font-bold hover:underline">VIEW DETAILS →</a>
      </div>
    ))}
  </section>

  <section class="bg-white/5 py-16">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <h2 class="text-2xl md:text-3xl font-black text-center mb-10">PROGRAMME DETAILS</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {programmes.map((p) => (
          <div class="bg-black border border-white/10 rounded-xl p-6">
            <h3 class="font-black mb-2">{p.title}</h3>
            <p class="text-sm text-white/70 mb-4">{p.desc}</p>
            <p class="text-xs font-bold text-brand-red mb-4">IDEAL FOR: {p.idealFor}</p>
            <a href="/#free-trial" class="text-sm font-bold hover:underline">BOOK FREE TRIAL →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 text-center">
    <a href="/#free-trial" class="inline-block bg-brand-red px-8 py-3 font-bold rounded hover:bg-red-700">CLAIM YOUR FREE TRIAL</a>
  </section>
</Layout>
