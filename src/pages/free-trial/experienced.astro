  description="Already train BJJ, MMA, Wrestling or Judo? Book a free trial at Guildford Jiu Jitsu and join a mat full of experienced and welcoming training partners."
  path="/free-trial/experienced"
  calendarId="Eer3xvSGu4AKeCMhsCQJ"
  label="Experienced Grappler"
