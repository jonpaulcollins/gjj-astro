  <style>
    .animate-fade-up { animation: fade-up 1s ease-out both; }
    @keyframes fade-up {
      0% { opacity: 0; transform: translateY(30px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    #podium-track {
      animation: podium-scroll 60s linear infinite;
    }
    #podium-marquee:hover #podium-track {
      animation-play-state: paused;
    }
    @keyframes podium-scroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      #podium-track { animation: none; }
    }
  </style>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // Timetable page quick-FAQ accordion
      document.querySelectorAll(".tt-faq-toggle").forEach((btn) => {
        btn.addEventListener("click", () => {
          const panel = btn.nextElementSibling;
          const icon = btn.querySelector(".tt-faq-icon");
          const isOpen = panel.style.maxHeight && panel.style.maxHeight !== "0px";
          if (isOpen) {
            panel.style.maxHeight = "0px";
            icon.style.transform = "rotate(0deg)";
          } else {
            panel.style.maxHeight = panel.scrollHeight + "px";
            icon.style.transform = "rotate(45deg)";
          }
        });
      });

      // Filter tabs (desktop grid + mobile panels)
      const filterBtns = document.querySelectorAll(".tt-filter-btn");
      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const filter = btn.getAttribute("data-filter");
          filterBtns.forEach((b) => {
            b.classList.toggle("bg-brand-red", b === btn);
            b.classList.toggle("text-white", b === btn);
            b.classList.toggle("bg-white/5", b !== btn);
            b.classList.toggle("text-white/60", b !== btn);
          });
          document.querySelectorAll("[data-cat]").forEach((el) => {
            const cat = el.getAttribute("data-cat");
            const show = filter === "all" || filter === cat || (filter === "private" && el.textContent.includes("Private"));
            el.style.display = show ? "" : "none";
          });
          document.querySelectorAll(".flex-col.gap-2.p-1\\.5").forEach((cell) => {
            // no-op placeholder to keep desktop cell layout intact
          });
        });
      });

      // Mobile day pills
      const dayPills = document.querySelectorAll(".tt-day-pill");
      const dayPanels = document.querySelectorAll(".tt-day-panel");
      dayPills.forEach((pill) => {
        pill.addEventListener("click", () => {
          const day = pill.getAttribute("data-day");
          dayPills.forEach((p) => {
            const active = p === pill;
            p.classList.toggle("bg-brand-red", active);
            p.classList.toggle("text-white", active);
            p.classList.toggle("border-brand-red", active);
            p.classList.toggle("bg-white/5", !active);
            p.classList.toggle("text-white/60", !active);
            p.classList.toggle("border-white/10", !active);
          });
          dayPanels.forEach((panel) => {
            panel.style.display = panel.getAttribute("data-day") === day ? "" : "none";
          });
        });
      });

      // Help Me Choose quiz
      const quizModal = document.getElementById("choose-quiz-modal");
      const quizOpenBtn = document.getElementById("choose-quiz-open");
      const quizCloseBtn = document.getElementById("choose-quiz-close");
      const quizSteps = document.querySelectorAll("[data-quiz-step]");
      const quizAnswers = { age: "", gender: "", exp: "" };

      function showQuizStep(step) {
        quizSteps.forEach((el) => {
          el.classList.toggle("hidden", el.getAttribute("data-quiz-step") !== step);
        });
      }

      function resetQuiz() {
        quizAnswers.age = "";
        quizAnswers.gender = "";
        quizAnswers.exp = "";
        showQuizStep("age");
      }

      function openQuiz() {
        if (!quizModal) return;
        resetQuiz();
        quizModal.classList.remove("hidden");
        quizModal.classList.add("flex");
        document.body.style.overflow = "hidden";
      }

      function closeQuiz() {
        if (!quizModal) return;
        quizModal.classList.add("hidden");
        quizModal.classList.remove("flex");
        document.body.style.overflow = "";
      }

      if (quizOpenBtn) quizOpenBtn.addEventListener("click", openQuiz);
      if (quizCloseBtn) quizCloseBtn.addEventListener("click", closeQuiz);
      if (quizModal) {
        quizModal.addEventListener("click", (e) => { if (e.target === quizModal) closeQuiz(); });
      }
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeQuiz(); });

      // Placeholder testimonial videos — one per quiz outcome bucket.
      // Replace the `src` value with the real hosted video file once each is filmed
      // (e.g. "/videos/testimonial-teens.mp4"), and the placeholder box will
      // automatically swap for a real playable video.
      const testimonialVideos = {
        juniors: { label: "A Junior's Story", src: "" },
        teens: { label: "A Teen's Story", src: "" },
        "women-beginner": { label: "A Beginner Woman's Story", src: "" },
        "women-experienced": { label: "An Experienced Woman's Story", src: "" },
        "men-beginner": { label: "A Beginner Man's Story", src: "" },
        "men-experienced": { label: "An Experienced Man's Story", src: "" },
      };

      function computeRecommendation() {
        const weekdays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
        if (quizAnswers.age === "kids") {
          return {
            filter: "kids",
            title: "Junior BJJ Classes",
            desc: "Perfect for children aged 5–10. Fun, safe, play-based classes that build confidence and focus, on weekday evenings.",
            matchers: [{ keyword: "junior", days: weekdays }],
            videoSlug: "juniors",
          };
        }
        if (quizAnswers.age === "teens") {
          return {
            filter: "kids",
            title: "Teen BJJ Classes",
            desc: "Designed for 10–15 year olds, building resilience, strength and positive friendships, on weekday evenings.",
            matchers: [{ keyword: "teen", days: weekdays }],
            videoSlug: "teens",
          };
        }
        if (quizAnswers.gender === "female" && quizAnswers.exp === "beginner") {
          return {
            filter: "adults",
            title: "Women's Only Class + Foundations BJJ",
            desc: "Join the UK's biggest and most welcoming women's team, plus our beginner-friendly Foundations sessions — lunchtime Monday & Wednesday, or evenings Tuesday & Thursday.",
            matchers: [
              { keyword: "women only" },
              { keyword: "foundations", day: "Monday", band: "noon", exclude: "mma" },
              { keyword: "foundations", day: "Wednesday", band: "noon", exclude: "mma" },
              { keyword: "foundations", day: "Tuesday", band: "evening", exclude: "mma" },
              { keyword: "foundations", day: "Thursday", band: "evening", exclude: "mma" },
            ],
            videoSlug: "women-beginner",
          };
        }
        if (quizAnswers.exp === "experienced") {
          const isMale = quizAnswers.gender === "male";
          return {
            filter: "adults",
            title: "All Adult Sessions",
            desc: isMale
              ? "As an experienced grappler you're welcome at any adult class on the timetable — Foundations, All Levels, Sparring and early-morning Wrestling included."
              : "As an experienced grappler you're welcome at any adult class on the timetable — Foundations, All Levels, Sparring, early-morning Wrestling and our Women's Only Class included.",
            matchers: isMale ? [{ all: true, exclude: "women only" }] : [{ all: true }],
            videoSlug: isMale ? "men-experienced" : "women-experienced",
          };
        }
        return {
          filter: "adults",
          videoSlug: "men-beginner",
          title: "Foundations BJJ",
          desc: "The perfect starting point — a structured, beginner-friendly introduction to real Jiu Jitsu skills, in both Gi and No-Gi.",
          matchers: [{ keyword: "foundations", exclude: "mma" }],
        };
      }

      function showResult() {
        const rec = computeRecommendation();
        const titleEl = document.getElementById("quiz-result-title");
        const descEl = document.getElementById("quiz-result-desc");
        if (titleEl) titleEl.textContent = rec.title;
        if (descEl) descEl.textContent = rec.desc;
        const seeTimesBtn = document.getElementById("quiz-see-times");
        if (seeTimesBtn) seeTimesBtn.setAttribute("data-rec-filter", rec.filter);
        if (seeTimesBtn) seeTimesBtn.setAttribute("data-rec-matchers", JSON.stringify(rec.matchers));

        const videoWrap = document.getElementById("quiz-video-wrap");
        const videoEl = document.getElementById("quiz-video-el");
        const videoSourceEl = document.getElementById("quiz-video-source");
        const videoPlaceholder = document.getElementById("quiz-video-placeholder");
        const videoLabelEl = document.getElementById("quiz-video-label");
        const video = testimonialVideos[rec.videoSlug] || { label: "", src: "" };
        if (videoWrap) videoWrap.setAttribute("data-video-slug", rec.videoSlug || "");
        if (videoLabelEl) videoLabelEl.textContent = video.label;
        if (video.src) {
          if (videoSourceEl) videoSourceEl.setAttribute("src", video.src);
          if (videoEl) { videoEl.load(); videoEl.classList.remove("hidden"); }
          if (videoPlaceholder) videoPlaceholder.classList.add("hidden");
        } else {
          if (videoEl) videoEl.classList.add("hidden");
          if (videoPlaceholder) videoPlaceholder.classList.remove("hidden");
        }

        showQuizStep("result");
      }

      document.querySelectorAll("[data-age]").forEach((btn) => {
        btn.addEventListener("click", () => {
          quizAnswers.age = btn.getAttribute("data-age");
          if (quizAnswers.age === "adult") {
            showQuizStep("gender");
          } else {
            showResult();
          }
        });
      });

      document.querySelectorAll("[data-gender]").forEach((btn) => {
        btn.addEventListener("click", () => {
          quizAnswers.gender = btn.getAttribute("data-gender");
          showQuizStep("experience");
        });
      });

      document.querySelectorAll("[data-exp]").forEach((btn) => {
        btn.addEventListener("click", () => {
          quizAnswers.exp = btn.getAttribute("data-exp");
          showResult();
        });
      });

      const seeTimesBtn = document.getElementById("quiz-see-times");
      if (seeTimesBtn) {
        seeTimesBtn.addEventListener("click", () => {
          const filter = seeTimesBtn.getAttribute("data-rec-filter") || "all";
          let matchers = [];
          try {
            matchers = JSON.parse(seeTimesBtn.getAttribute("data-rec-matchers") || "[]");
          } catch (e) {
            matchers = [];
          }
          closeQuiz();
          const targetFilterBtn = document.querySelector(`.tt-filter-btn[data-filter="${filter}"]`);
          if (targetFilterBtn) targetFilterBtn.click();
          const grid = document.getElementById("timetable-grid");
          if (grid) grid.scrollIntoView({ behavior: "smooth", block: "start" });
          setTimeout(() => {
            const rows = Array.from(document.querySelectorAll("[data-cat]"));
            const matches = rows.filter((row) => {
              const cat = row.getAttribute("data-cat");
              const day = row.getAttribute("data-day") || "";
              const band = row.getAttribute("data-band") || "";
              const p = row.querySelector("p");
              const text = p ? p.textContent.toLowerCase() : "";
              // Global exclusions: never highlight MMA, Blue-Light, or Sparring classes unless explicitly matched.
              if (text.includes("mma")) return false;
              if (text.includes("blue-light") || text.includes("blue light")) return false;
              return matchers.some((m) => {
                if (m.all) {
                  if (m.exclude && text.includes(m.exclude)) return false;
                  return cat === "adults";
                }
                if (!text.includes(m.keyword)) return false;
                if (m.exclude && text.includes(m.exclude)) return false;
                if (m.day && day !== m.day) return false;
                if (m.days && !m.days.includes(day)) return false;
                if (m.band && band !== m.band) return false;
                return true;
              });
            });
            matches.forEach((row) => {
              row.classList.add("ring-4", "ring-brand-red", "ring-offset-2", "ring-offset-zinc-950");
            });
            if (matches[0]) matches[0].scrollIntoView({ behavior: "smooth", block: "center" });
          }, 500);
        });
      }
    });
  </script>
</Layout>
