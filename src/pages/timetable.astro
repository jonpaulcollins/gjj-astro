  <!-- HELP ME CHOOSE QUIZ -->
  <div id="choose-quiz-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4" role="dialog" aria-modal="true">
    <div class="relative w-full max-w-lg bg-zinc-950 border border-white/10 rounded-2xl overflow-hidden text-white">
      <button id="choose-quiz-close" type="button" class="absolute top-4 right-4 p-2 bg-black/50 hover:bg-black/80 rounded-full text-white transition-colors z-10" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      <div class="p-8">
        <div data-quiz-step="age">
          <p class="text-brand-red font-bold tracking-[0.2em] uppercase text-xs mb-2">Step 1 of 3</p>
          <h3 class="text-2xl font-black uppercase tracking-tighter mb-6">How old are you?</h3>
          <div class="space-y-3">
            <button data-age="kids" class="quiz-option w-full text-left border border-white/10 hover:border-brand-red rounded-lg px-5 py-4 font-bold transition-colors">Under 10</button>
            <button data-age="teens" class="quiz-option w-full text-left border border-white/10 hover:border-brand-red rounded-lg px-5 py-4 font-bold transition-colors">10 – 15</button>
            <button data-age="adult" class="quiz-option w-full text-left border border-white/10 hover:border-brand-red rounded-lg px-5 py-4 font-bold transition-colors">16 or over</button>
