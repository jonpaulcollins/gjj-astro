            <button data-gender="female" class="quiz-option w-full text-left border border-white/10 hover:border-brand-red rounded-lg px-5 py-4 font-bold transition-colors">Female</button>
            <button data-gender="male" class="quiz-option w-full text-left border border-white/10 hover:border-brand-red rounded-lg px-5 py-4 font-bold transition-colors">Male</button>
          </div>
        </div>

        <div data-quiz-step="experience" class="hidden">
          <p class="text-brand-red font-bold tracking-[0.2em] uppercase text-xs mb-2">Step 3 of 3</p>
          <h3 class="text-2xl font-black uppercase tracking-tighter mb-6">What's your experience?</h3>
          <div class="space-y-3">
            <button data-exp="beginner" class="quiz-option w-full text-left border border-white/10 hover:border-brand-red rounded-lg px-5 py-4 font-bold transition-colors">Complete beginner</button>
            <button data-exp="experienced" class="quiz-option w-full text-left border border-white/10 hover:border-brand-red rounded-lg px-5 py-4 font-bold transition-colors">Some grappling experience</button>
          </div>
        </div>

        <div data-quiz-step="result" class="hidden">
          <p class="text-brand-red font-bold tracking-[0.2em] uppercase text-xs mb-2">Your Recommendation</p>
          <h3 id="quiz-result-title" class="text-2xl md:text-3xl font-black uppercase tracking-tighter mb-4"></h3>
          <p id="quiz-result-desc" class="text-white/70 mb-6"></p>

          <!-- Testimonial video placeholder: swap the <source src> below for the real file once filmed. -->
          <div id="quiz-video-wrap" class="relative w-full aspect-video bg-black border border-white/10 rounded-lg mb-8 overflow-hidden flex items-center justify-center" data-video-slug="">
            <video id="quiz-video-el" class="w-full h-full object-cover hidden" controls playsinline>
              <source id="quiz-video-source" src="" type="video/mp4" />
            </video>
            <div id="quiz-video-placeholder" class="flex flex-col items-center gap-3 text-white/50 p-6 text-center">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-brand-red">
                <circle cx="12" cy="12" r="10"/><path d="m10 8 6 4-6 4Z" fill="currentColor" stroke="none"/>
              </svg>
              <span id="quiz-video-label" class="text-xs font-bold uppercase tracking-widest"></span>
              <span class="text-[10px] uppercase tracking-widest text-white/30">Testimonial video coming soon</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <button id="quiz-see-times" type="button" class="flex-1 inline-flex items-center justify-center border border-white/20 hover:border-brand-red text-white font-bold uppercase tracking-widest px-6 py-4 rounded-lg transition-colors">See Times On Timetable</button>
            <a href="/#free-trial" class="flex-1 inline-flex items-center justify-center bg-brand-red hover:bg-red-700 text-white font-bold uppercase tracking-widest px-6 py-4 rounded-lg transition-colors">Book Free Trial →</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- OUR PROGRAMMES -->
  <section class="py-16 md:py-24 bg-black border-b border-white/5">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <h2 class="text-2xl md:text-4xl font-black text-center uppercase tracking-tighter mb-12">Our Programmes</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {programmes.map((p) => (
          <a href="/#free-trial" class="group bg-zinc-950 border border-white/10 rounded-2xl overflow-hidden flex flex-col hover:border-brand-red/50 transition-colors cursor-pointer">
            <div class="aspect-[4/3] overflow-hidden" style={p.imageZoom ? `transform: scale(${p.imageZoom})` : undefined}>
              <img src={p.image} alt={p.title} style={p.imagePosition ? `object-position: ${p.imagePosition}` : undefined} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80 group-hover:opacity-100" loading="lazy" />
            </div>
            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-xl md:text-2xl font-black mb-2 uppercase tracking-tight">{p.title}</h3>
