              <span class="text-sm md:text-base font-bold group-hover:text-brand-red transition-colors">{item.q}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tt-faq-icon w-5 h-5 flex-shrink-0 transition-transform"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            </button>
