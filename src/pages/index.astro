      const modal = document.getElementById("coach-modal");
      const modalImg = document.getElementById("coach-modal-img");
      const pretitleEl = document.getElementById("coach-modal-pretitle");
      const nameEl = document.getElementById("coach-modal-name");
      const paragraphsEl = document.getElementById("coach-modal-paragraphs");
      const lineageImg = document.getElementById("coach-modal-lineage");
      const closeBtn = document.getElementById("coach-modal-close");

      function openModal(btn) {
        if (!modal) return;
        modalImg.src = btn.dataset.image || "";
        modalImg.alt = btn.dataset.name || "";
        modalImg.style.objectPosition = btn.dataset.imagePosition || "center";
        modalImg.style.transformOrigin = btn.dataset.imagePosition || "center";
        modalImg.style.transform = btn.dataset.imageScale ? `scale(${btn.dataset.imageScale})` : "";
        modalImg.classList.toggle("grayscale", btn.dataset.grayscale === "true");
        pretitleEl.textContent = btn.dataset.pretitle || "";
        nameEl.textContent = btn.dataset.name || "";

        paragraphsEl.innerHTML = "";
        let paragraphs = [];
        try {
          paragraphs = JSON.parse(btn.dataset.paragraphs || "[]");
        } catch (e) {
          paragraphs = [];
        }
        paragraphs.forEach((text) => {
          const p = document.createElement("p");
          p.textContent = text;
          paragraphsEl.appendChild(p);
        });
        if (btn.dataset.quote) {
          const quoteP = document.createElement("p");
          quoteP.className = "font-bold text-white uppercase tracking-widest pt-2";
          quoteP.textContent = `"${btn.dataset.quote}"`;
          paragraphsEl.appendChild(quoteP);
        }

        lineageImg.src = btn.dataset.lineageImage || "";
        lineageImg.alt = btn.dataset.lineageAlt || "";

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        document.body.style.overflow = "";
      }

      document.querySelectorAll(".coach-card-clickable").forEach((card) => {
        card.addEventListener("click", () => openModal(card));
        card.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            openModal(card);
          }
        });
      });

      if (closeBtn) closeBtn.addEventListener("click", closeModal);
      if (modal) {
        modal.addEventListener("click", (e) => {
          if (e.target === modal) closeModal();
        });
      }
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeModal();
      });
    })();
  </script>

