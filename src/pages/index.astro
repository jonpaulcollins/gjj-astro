  <script>
    function playTestimonial(card: Element) {
      const id = card.getAttribute("data-video-id");
      if (!id || card.querySelector("iframe")) return;
      card.innerHTML = `<iframe
        src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0&playsinline=1"
        class="absolute inset-0 w-full h-full"
        style="border:0"
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen
      ></iframe>`;
    }
    document.querySelectorAll(".video-testimonial, .coach-video").forEach((card) => {
      card.addEventListener("click", () => playTestimonial(card));
      card.addEventListener("keydown", (e) => {
        if ((e as KeyboardEvent).key === "Enter" || (e as KeyboardEvent).key === " ") {
          e.preventDefault();
          playTestimonial(card);
        }
      });
    });

    document.querySelectorAll(".client-logo").forEach((logo) => {
      logo.addEventListener("click", () => logo.classList.toggle("is-active"));
    });

    const track = document.getElementById("stories-track");
    const prevBtn = document.getElementById("stories-prev");
    const nextBtn = document.getElementById("stories-next");
    if (track && prevBtn && nextBtn) {
      const scrollAmount = () => track.clientWidth * 0.8;
      prevBtn.addEventListener("click", () => {
        track.scrollBy({ left: -scrollAmount(), behavior: "smooth" });
      });
      nextBtn.addEventListener("click", () => {
        track.scrollBy({ left: scrollAmount(), behavior: "smooth" });
      });
    }
