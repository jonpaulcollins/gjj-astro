---
// redeploy trigger
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { pullQuotes, studentStories } from "../data/testimonials";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.domain + "/",
  },
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    name: site.name,
    image: site.domain + "/favicon.svg",
    url: site.domain + "/",
    telephone: site.phone,
    address: {
      "@type": "PostalAddress",
      streetAddress: site.address.street,
      addressLocality: site.address.locality,
      addressRegion: site.address.region,
      postalCode: site.address.postalCode,
      addressCountry: site.address.country,
    },
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        opens: "06:00",
        closes: "22:00",
      },
    ],
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: "5.0",
      reviewCount: "214",
    },
  },
];

const stats = [
  { value: "7", label: "DAYS / WEEK" },
  { value: "20+", label: "YEARS EXPERIENCE" },
  { value: "200+", label: "5★ REVIEWS" },
  { value: "300+", label: "COMPETITION MEDALS" },
  { value: "400+", label: "LIVES TRANSFORMED" },
  { value: "1000+", label: "CLASSES EVERY YEAR" },
];

const programmes = [
  {
    title: "ADULTS PROGRAMMES (15YRS+)",
    tagline: "JIU-JITSU IS A SUPERPOWER!",
    bullets: ["Build Confidence", "Strengthen Body & Mind", "Learn Real Self Defence"],
    href: "/classes",
    image: "/images/programme-adults-superpower.jpg",
  },
  {
    title: "KIDS CLASSES (5-15YRS)",
    tagline: "SWAP THEIR SCREEN HOURS FOR SUPERPOWERS - & BULLY-PROOF YOUR CHILD TODAY",
    bullets: ["Self Confidence", "Focus", "Friendship"],
    href: "/classes",
    image: "/images/programme-kids-screentime.jpg",
  },
  {
    title: "WOMEN ONLY CLASSES",
    tagline: "WOMEN EMPOWERED! UK'S BIGGEST WOMEN'S TEAM",
    bullets: ["Physical Confidence", "Fitness & Energy", "Supportive Community"],
    href: "/classes",
    image: "/images/programme-women-team.jpg",
  },
];

const teamShowcase = [
  {
    title: "Adults Brazilian Jiu Jitsu (age 15+)",
    image: "/images/team-adults-bjj.png",
    href: "/classes",
  },
  {
    title: "Adults Submission Grappling/NoGi (age 15+)",
    image: "/images/team-adults-nogi.png",
    href: "/classes",
  },
  {
    title: "Juniors & Teens BJJ & Submission Grappling (age 5-15)",
    image: "/images/team-juniors-teens.png",
    href: "/classes",
  },
  {
    title: "Women's Brazilian Jiu Jitsu & NoGi (age 13+)",
    image: "/images/ChatGPT%20Image%20Jul%2031%2C%202026%2C%2011_33_42%20AM.png",
    href: "/classes",
  },
];

const pastClients = [
  { name: "Harlequins", image: "/images/client-harlequins.png" },
  { name: "AFC Bournemouth", image: "/images/client-afc-bournemouth.png" },
  { name: "Oxford University Sport", image: "/images/client-oxford-university-sport.png" },
  { name: "Surrey Police", image: "/images/client-surrey-police.png" },
  { name: "MOD Police", image: "/images/client-mod-police.png" },
];

const coaches = [
  {
    name: "MAURICIO GOMES",
    belt: "BJJ CORAL BELT",
    bio: "Highest grade Jiu Jitsu master in Europe. Coral belt & the godfather of BJJ in the UK. Part of the Gracie family & the roots of BJJ. Father to Roger Gracie (the greatest of all time).",
    href: "/classes",
    image: "/images/coach-mauricio-gomes.png",
    imgClass: "object-top",
  },
  {
    name: "JON COLLINS",
    belt: "BJJ BLACK BELT",
    bio: "20+ years in professional sports coaching. Black belt under Mauricio Gomes. Former police firearms officer.",
    href: "/classes",
    image: "/images/coach-jon-collins.jpg",
    imgClass: "scale-125",
  },
];

const gallery = [
  { caption: "Our Amazing Women's Team", image: "https://static.wixstatic.com/media/eb8f02_47929d99c4164dbd952a43cc4c0ba485~mv2.jpg/v1/fill/w_600,h_600,q_90,enc_avif,quality_auto/eb8f02_47929d99c4164dbd952a43cc4c0ba485~mv2.jpg" },
  { caption: "Tom Hardy Visits Guildford Jiu Jitsu", image: "https://static.wixstatic.com/media/eb8f02_09229b5f8d73471d90f144c459ffa084~mv2.jpg/v1/fill/w_600,h_600,q_90,enc_avif,quality_auto/eb8f02_09229b5f8d73471d90f144c459ffa084~mv2.jpg" },
  { caption: "Belt Promotions with Master Mauricio", image: "https://static.wixstatic.com/media/eb8f02_5bfc552ef1014b049a5542b36c077da1~mv2.jpg/v1/fill/w_600,h_600,q_90,enc_avif,quality_auto/eb8f02_5bfc552ef1014b049a5542b36c077da1~mv2.jpg" },
  { caption: "Lunchtime Crew in the Gi", image: "https://static.wixstatic.com/media/eb8f02_ffa16a97efd2463bafd4a5062e7c7539~mv2.jpg/v1/fill/w_600,h_600,q_90,enc_avif,quality_auto/eb8f02_ffa16a97efd2463bafd4a5062e7c7539~mv2.jpg" },
  { caption: "The Boss - Master Mauricio Gomes", image: "https://static.wixstatic.com/media/eb8f02_ed93f80df38d4ffc903fab78b9381f41~mv2.jpg/v1/fill/w_600,h_600,q_90,enc_avif,quality_auto/eb8f02_ed93f80df38d4ffc903fab78b9381f41~mv2.jpg" },
  { caption: "Submission Grappling Everyday", image: "https://static.wixstatic.com/media/eb8f02_b49141909e244e9a97221ef4bb5382c0~mv2.jpg/v1/fill/w_600,h_600,q_90,enc_avif,quality_auto/eb8f02_b49141909e244e9a97221ef4bb5382c0~mv2.jpg" },
  { caption: "Kids BJJ Classes", image: "https://static.wixstatic.com/media/eb8f02_fcfb5217a3b74c84af0bb98f290489d9~mv2.jpg/v1/fill/w_600,h_600,q_90,enc_avif,quality_auto/eb8f02_fcfb5217a3b74c84af0bb98f290489d9~mv2.jpg" },
  { caption: "Competition Team Training", image: "https://static.wixstatic.com/media/eb8f02_a5c082ba3d834845b364a8f01f6cdf43~mv2.jpg/v1/fill/w_600,h_600,q_90,enc_avif,quality_auto/eb8f02_a5c082ba3d834845b364a8f01f6cdf43~mv2.jpg" },
  { caption: "Back When They Were White Belts", image: "https://static.wixstatic.com/media/eb8f02_fcaef2893141489fa823f0135c691548~mv2.jpg/v1/fill/w_600,h_600,q_90,enc_avif,quality_auto/eb8f02_fcaef2893141489fa823f0135c691548~mv2.jpg" },
  { caption: "Training in the Gi", image: "https://static.wixstatic.com/media/eb8f02_e94d56beca604aa59c9da4f795d006b9~mv2.jpg/v1/fill/w_600,h_600,q_90,enc_avif,quality_auto/eb8f02_e94d56beca604aa59c9da4f795d006b9~mv2.jpg" },
  { caption: "Grading Day Celebrations", image: "https://static.wixstatic.com/media/eb8f02_cb27a61b919f4ee0912982c37905e3bd~mv2.jpg/v1/fill/w_600,h_600,q_90,enc_avif,quality_auto/eb8f02_cb27a61b919f4ee0912982c37905e3bd~mv2.jpg" },
  { caption: "Women Only Classes", image: "https://static.wixstatic.com/media/eb8f02_88a427a4a0664a93b918be25c2ed69e3~mv2.jpg/v1/fill/w_600,h_600,q_90,enc_avif,quality_auto/eb8f02_88a427a4a0664a93b918be25c2ed69e3~mv2.jpg" },
];
---
<Layout
  title="Guildford Jiu Jitsu — A Stronger You Starts Here"
  description="Guildford Jiu Jitsu is Surrey's premier Brazilian Jiu Jitsu and grappling academy. We offer BJJ classes for adults, kids, and women in a modern, welcoming environment."
  path="/"
  schema={schema}
>
  <!-- HERO -->
  <section class="relative bg-black text-white overflow-hidden min-h-[600px] flex items-center">
    <div class="absolute inset-0 z-0">
      <iframe
        src="https://player.vimeo.com/video/1211189296?h=3b5f5e2000&background=1&autoplay=1&loop=1&muted=1"
        class="absolute top-1/2 left-1/2 w-[177.77vh] min-w-full h-[56.25vw] min-h-full -translate-x-1/2 -translate-y-1/2"
        frameborder="0"
        allow="autoplay; fullscreen"
        title="Guildford Jiu Jitsu hero video"
      ></iframe>
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 md:px-8 py-20 md:py-32">
      <p class="text-brand-red font-bold tracking-widest mb-4">GUILDFORD, SURREY (EST. 2021)</p>
      <h1 class="text-5xl md:text-7xl font-black leading-none mb-6">
        A STRONGER YOU<br /><span class="text-brand-red">STARTS HERE</span>
      </h1>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/#free-trial" class="bg-brand-red px-6 py-3 font-bold rounded hover:bg-red-700">CLAIM FREE TRIAL →</a>
        <a href="/timetable" class="border border-white/30 px-6 py-3 font-bold rounded hover:border-white">VIEW TIMETABLE</a>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <section class="bg-brand-red/5 border-y border-white/10">
    <div class="mx-auto max-w-7xl px-4 md:px-8 py-10 grid grid-cols-2 md:grid-cols-6 gap-6 text-center">
      {stats.map((s) => (
        <div>
          <p class="text-3xl md:text-4xl font-black text-brand-red">{s.value}</p>
          <p class="text-xs md:text-sm font-semibold text-white/70 tracking-wide">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- JIU JITSU IS FOR YOU -->
  <section class="relative bg-black overflow-hidden">
    <div class="grid md:grid-cols-2 items-stretch">
      <div class="relative h-[420px] md:h-auto md:min-h-[720px]">
        <img
          src="/images/mauricio-gomes.jpg"
          alt="Mauricio Gomes, BJJ Coral Belt coach at Guildford Jiu Jitsu, pointing at the camera"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="flex items-center px-4 md:px-8 lg:pr-16 py-16 md:py-24">
        <div class="max-w-xl">
          <h2 class="text-3xl md:text-4xl font-black mb-4">JIU JITSU IS FOR YOU!</h2>
          <p class="text-white/70 mb-6">All ages. All abilities. No experience needed.</p>
          <ul class="grid sm:grid-cols-2 gap-3 text-white/90 mb-8">
            <li class="flex items-start gap-2"><span class="text-brand-red">✓</span> Build confidence</li>
            <li class="flex items-start gap-2"><span class="text-brand-red">✓</span> Get fitter and stronger</li>
            <li class="flex items-start gap-2"><span class="text-brand-red">✓</span> Learn proven self-defence</li>
            <li class="flex items-start gap-2"><span class="text-brand-red">✓</span> Train in a safe, welcoming environment</li>
          </ul>
          <p class="text-white/70 mb-2">
            Become stronger, fitter and more confident alongside hundreds of Guildford locals
            already training at Guildford Jiu Jitsu.
          </p>
          <p class="font-bold mb-6">LIMITED BEGINNER SPACES AVAILABLE. CLAIM YOUR FREE TRIAL TODAY.</p>
          <a href="/#free-trial" class="inline-block bg-brand-red px-8 py-3 font-bold rounded hover:bg-red-700">
            START YOUR JIU JITSU JOURNEY
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAMME CARDS -->
  <section class="bg-white/5 py-20">
    <div class="mx-auto max-w-7xl px-4 md:px-8 grid md:grid-cols-3 gap-8">
      {programmes.map((p) => (
        <div class="bg-black border border-white/10 rounded-xl overflow-hidden">
          <img
            src={p.image}
            alt={p.title}
            class="w-full h-56 object-cover object-[center_18%]"
            loading="lazy"
          />
          <div class="p-6">
            <p class="text-brand-red font-bold text-sm mb-2">{p.tagline}</p>
            <h3 class="text-xl font-black mb-4">{p.title}</h3>
            <ul class="space-y-1 text-white/80 mb-6">
              {p.bullets.map((b) => <li class="flex items-center gap-2"><span class="text-brand-red">✓</span> {b}</li>)}
            </ul>
            <a href={p.href} class="text-brand-red font-bold hover:underline">LEARN MORE →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- GOOGLE REVIEWS -->
  <section class="mx-auto max-w-7xl px-4 md:px-8 py-20">
    <h2 class="text-3xl md:text-4xl font-black text-center mb-10 flex items-center justify-center gap-3 flex-wrap">
      TRUSTED
      <svg class="w-8 h-8 md:w-9 md:h-9 shrink-0" viewBox="0 0 48 48" aria-label="Google">
        <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"/>
        <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.5 15.1 18.9 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
        <path fill="#4CAF50" d="M24 44c5.5 0 10.5-2.1 14.3-5.5l-6.6-5.6C29.6 34.7 26.9 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.6 39.6 16.3 44 24 44z"/>
        <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.2 4.3-4.1 5.7l6.6 5.6C41.6 36 44 30.5 44 24c0-1.3-.1-2.7-.4-3.5z"/>
      </svg>
      REVIEWS
    </h2>
    <script is:inline type="text/javascript" src="https://reputationhub.site/reputation/assets/review-widget.js"></script>
    <iframe
      class="lc_reviews_widget"
      src="https://reputationhub.site/reputation/widgets/review_widget/3lxJJ7cu1zHYhHZZrgTx?widgetId=6a6b26a608d0db90a29a2a7b"
      frameborder="0"
      scrolling="no"
      style="min-width: 100%; width: 100%;"
    ></iframe>
  </section>

  <!-- SCROLLING QUOTES RIBBON -->
  <section class="bg-brand-red py-4 overflow-hidden">
    <div class="marquee-track flex w-max">
      <div class="flex items-center shrink-0">
        {pullQuotes.map((q) => (
          <span class="flex items-center shrink-0">
            <span class="text-white font-black text-sm md:text-base tracking-wide whitespace-nowrap px-6">"{q}"</span>
            <span class="text-white/40">•</span>
          </span>
        ))}
      </div>
      <div class="flex items-center shrink-0" aria-hidden="true">
        {pullQuotes.map((q) => (
          <span class="flex items-center shrink-0">
            <span class="text-white font-black text-sm md:text-base tracking-wide whitespace-nowrap px-6">"{q}"</span>
            <span class="text-white/40">•</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- STUDENT STORIES -->
  <section class="bg-white/5 py-20 overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <h2 class="text-3xl md:text-4xl font-black text-center mb-2">REAL PEOPLE. REAL PROGRESS.</h2>
      <p class="text-center text-white/70 mb-10">STUDENT TESTIMONIALS</p>
      <div class="relative">
        <button
          type="button"
          id="stories-prev"
          aria-label="Scroll testimonials left"
          class="hidden md:flex absolute -left-6 top-1/2 -translate-y-1/2 z-10 w-16 h-16 rounded-full bg-white border-2 border-black hover:bg-black items-center justify-center shadow-xl transition-colors group/arrow"
        >
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover/arrow:stroke-white"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>
        <div id="stories-track" class="no-scrollbar flex gap-5 overflow-x-auto snap-x snap-mandatory pb-4 -mx-4 px-4 md:mx-0 md:px-0 scroll-smooth">
        {studentStories.map((s) => (
          <div
            class="video-testimonial group relative flex-none w-[210px] md:w-[250px] aspect-[9/16] rounded-xl overflow-hidden bg-black snap-start cursor-pointer"
            data-video-id={s.youtubeId}
            role="button"
            tabindex="0"
            aria-label={`Play ${s.name}'s testimonial video`}
          >
            <img
              src={`https://img.youtube.com/vi/${s.youtubeId}/hqdefault.jpg`}
              alt={`${s.name} testimonial video thumbnail`}
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/10 to-black/85"></div>
            <span class="absolute inset-0 flex items-center justify-center">
              <span class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-brand-red/90 flex items-center justify-center group-hover:scale-110 transition-transform">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"></path></svg>
              </span>
            </span>
            <p class="absolute top-4 left-4 right-4 font-bold text-white text-sm leading-snug drop-shadow">&ldquo;{s.quote}&rdquo;</p>
            <div class="absolute bottom-4 left-4 right-4">
              <p class="text-brand-red font-black text-sm">{s.name}</p>
              <p class="text-xs text-white/70">{s.detail}</p>
            </div>
          </div>
        ))}
        </div>
        <button
          type="button"
          id="stories-next"
          aria-label="Scroll testimonials right"
          class="hidden md:flex absolute -right-6 top-1/2 -translate-y-1/2 z-10 w-16 h-16 rounded-full bg-white border-2 border-black hover:bg-black items-center justify-center shadow-xl transition-colors group/arrow"
        >
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover/arrow:stroke-white"><path d="M9 18l6-6-6-6"></path></svg>
        </button>
      </div>
      <p class="text-center text-white/40 text-xs mt-2 md:hidden">&larr; Swipe to see more &rarr;</p>
    </div>
  </section>

  <style>
    .no-scrollbar {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .marquee-track {
      animation: marquee-scroll 28s linear infinite;
    }
    .marquee-track:hover {
      animation-play-state: paused;
    }
    @keyframes marquee-scroll {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-50%);
      }
    }
    .client-logo.is-active {
      filter: grayscale(0) !important;
      opacity: 1 !important;
    }
  </style>

  <script>
    function playTestimonial(card: Element) {
      const id = card.getAttribute("data-video-id");
      if (!id || card.querySelector("iframe")) return;
      card.innerHTML = `<iframe
        src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0&playsinline=1"
        class="absolute inset-0 w-full h-full"
        style="border:0"
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen
      ></iframe>`;
    }
    document.querySelectorAll(".video-testimonial, .coach-video").forEach((card) => {
      card.addEventListener("click", () => playTestimonial(card));
      card.addEventListener("keydown", (e) => {
        if ((e as KeyboardEvent).key === "Enter" || (e as KeyboardEvent).key === " ") {
          e.preventDefault();
          playTestimonial(card);
        }
      });
    });

    document.querySelectorAll(".client-logo").forEach((logo) => {
      logo.addEventListener("click", () => logo.classList.toggle("is-active"));
    });

    const track = document.getElementById("stories-track");
    const prevBtn = document.getElementById("stories-prev");
    const nextBtn = document.getElementById("stories-next");
    if (track && prevBtn && nextBtn) {
      const scrollAmount = () => track.clientWidth * 0.8;
      prevBtn.addEventListener("click", () => {
        track.scrollBy({ left: -scrollAmount(), behavior: "smooth" });
      });
      nextBtn.addEventListener("click", () => {
        track.scrollBy({ left: scrollAmount(), behavior: "smooth" });
      });
    }
  </script>

  <!-- TEAM SHOWCASE -->
  {teamShowcase.map((t) => (
    <section class="relative w-full overflow-hidden">
      <div class="relative h-[420px] md:h-[600px]">
        <img
          src={t.image}
          alt={t.title}
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 flex flex-col md:flex-row md:items-end md:justify-between gap-4 p-6 md:p-10">
          <h2 class="text-2xl md:text-4xl font-black uppercase max-w-2xl leading-tight">{t.title}</h2>
          <a
            href={t.href}
            class="inline-block bg-brand-red px-6 py-3 font-bold rounded hover:bg-red-700 transition-colors whitespace-nowrap w-fit"
          >
            LEARN MORE →
          </a>
        </div>
      </div>
    </section>
  ))}

  <!-- COACHES -->
  <section class="mx-auto max-w-5xl px-4 md:px-8 pt-20 pb-8">
    <h2 class="text-base md:text-xl font-semibold tracking-[0.15em] text-center text-white/90 mb-2">
      DEVELOPING THE SKILLS OF PROFESSIONAL ORGANISATIONS,
    </h2>
    <p class="text-base md:text-xl font-semibold tracking-[0.15em] text-center text-white/90 mb-12">SPORTS TEAMS &amp; ATHLETES FOR OVER 20 YEARS</p>

    <div
      class="coach-video group relative w-full aspect-video rounded-xl overflow-hidden bg-black border border-white/10 mb-16 cursor-pointer"
      data-video-id="bLrHQ6Dmmqc"
      role="button"
      tabindex="0"
      aria-label="Play Guildford Jiu Jitsu coaching video"
    >
      <img
