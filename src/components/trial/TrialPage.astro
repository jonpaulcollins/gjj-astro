---
// Shared layout for the 5 hidden free-trial booking pages (redesign, Wed 23 Sep 2026).
// Order follows Memory/research/booking-page-conversion-research.md — visitors are WARM
// (already enquired + chatted with the AI assistant) and mostly on mobile, so the page is short
// and the booking widget comes early:
//   hero → trust line → "your first class" → BOOKING WIDGET (+FAQ link) → coach → testimonials
//   → FAQs → back-to-booking button → (kids) child protection.
// Nav menu hidden (Jon, 23 Sep); header logo still links home; header button scrolls to #book.
import Layout from "../../layouts/Layout.astro";
import TrialBooking from "./TrialBooking.astro";
import TrialProof from "./TrialProof.astro";

interface Step { title: string; text: string }
interface Faq { q: string; a: string }
interface Review { name: string; text: string }
interface Story { quote: string; name: string; detail: string; youtubeId: string }
interface Props {
  title: string;
  description: string;
  path: string;
  calendarId: string;
  label: string;
  eyebrow: string;
  headlineTop: string;
  headlineRed: string;
  intro: string;
  heroImage: string;
  heroAlt: string;
  heroPosition?: string; // CSS object-position for the hero crop, e.g. "center 20%"
  trustQuote: { text: string; name: string };
  steps: Step[];
  coachQuote: string;
  reviews: Review[];
  stories?: Story[];
  faqs: Faq[];
  kids?: boolean;
  proofHeading?: string;
}
const p = Astro.props;
---
<Layout
  title={p.title}
  description={p.description}
  path={p.path}
  noindex={true}
  minimalHeader={true}
  headerCta={{ label: "BOOK FREE TRIAL", href: "#book" }}
>
  <!-- HERO — mobile: short photo band with the text overlapping it (reach the booking widget fast).
       Desktop: side-by-side, text left + square photo right (the supplied photos are square;
       a full-width band cropped faces off). -->
  <section class="relative md:grid md:grid-cols-2 md:gap-12 md:items-center md:max-w-6xl md:mx-auto md:px-8 md:py-12" id="trial-hero">
    <div class="relative h-[30vh] min-h-[220px] md:h-auto md:aspect-square md:order-2 md:rounded-2xl md:overflow-hidden">
      <img src={p.heroImage} alt={p.heroAlt} class="absolute inset-0 w-full h-full object-cover" style={`object-position: ${p.heroPosition ?? "center top"}`} />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/20 md:hidden"></div>
    </div>
    <div class="relative -mt-20 px-4 pb-8 md:mt-0 md:px-0 md:pb-0 md:order-1">
      <div class="mx-auto max-w-3xl text-center md:text-left">
        <p class="text-brand-red font-bold tracking-[0.3em] uppercase text-xs mb-3">{p.eyebrow}</p>
        <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none mb-4">
          {p.headlineTop}<br /><span class="text-brand-red">{p.headlineRed}</span>
        </h1>
        <p class="text-white/80 text-lg max-w-xl mx-auto md:mx-0">{p.intro}</p>
        <p class="mt-3 text-white font-bold uppercase tracking-widest text-xs">Free &middot; No contract &middot; No card needed</p>
        <a href="#book" class="mt-6 inline-flex items-center gap-2 bg-brand-red hover:bg-red-700 px-8 py-4 font-black uppercase tracking-widest text-sm transition-transform hover:scale-105">
          Pick Your Class Time <span aria-hidden="true">&darr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- TRUST LINE (real figure — Jon, 23 Sep 2026: 5.0 from 216 Google reviews; update as it grows) -->
  <section class="border-y border-white/10 py-5 px-4 text-center">
    <p class="font-bold tracking-wide"><span class="text-brand-red text-lg" aria-hidden="true">★★★★★</span> <span class="ml-1">5.0 from 216 Google reviews</span></p>
    <p class="text-white/60 text-sm italic mt-1">&ldquo;{p.trustQuote.text}&rdquo; &mdash; {p.trustQuote.name}</p>
  </section>

  <!-- YOUR FIRST CLASS (answers "what will happen?") -->
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h2 class="text-xl md:text-2xl font-black uppercase tracking-tighter mb-6 text-center">Your First Class</h2>
    <ol class="grid sm:grid-cols-3 gap-4">
      {p.steps.map((s, i) => (
        <li class="border border-white/10 p-5 text-center">
          <span class="mx-auto mb-3 w-9 h-9 rounded-full bg-brand-red flex items-center justify-center font-black">{i + 1}</span>
          <h3 class="font-bold uppercase tracking-wide text-sm mb-1">{s.title}</h3>
          <p class="text-white/60 text-sm leading-snug">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- BOOKING WIDGET -->
  <TrialBooking calendarId={p.calendarId} label={p.label} />

  <!-- COACH (authority + safety) -->
  <section class="bg-white/5 py-14">
    <div class="mx-auto max-w-3xl px-4 flex flex-col sm:flex-row items-center gap-8">
      <img src="/images/coach-jon-collins.jpg" alt="Jon Collins, Head Coach" class="w-32 h-32 rounded-full object-cover shrink-0" loading="lazy" />
      <div class="text-center sm:text-left">
        <p class="text-brand-red font-bold tracking-[0.2em] uppercase text-xs mb-2">Your Coach</p>
        <h3 class="text-xl font-black uppercase tracking-tight">Jon Collins</h3>
        <p class="text-white/60 text-sm mb-3">Head Coach &amp; Owner, Guildford Jiu Jitsu &middot; Black belt under Mauricio Gomes</p>
        <p class="text-white/80 leading-relaxed mb-4">&ldquo;{p.coachQuote}&rdquo;</p>
        <ul class="flex flex-wrap justify-center sm:justify-start gap-2 text-xs font-bold uppercase tracking-wide">
          <li class="border border-white/20 px-3 py-1">DBS checked</li>
          <li class="border border-white/20 px-3 py-1">First-aid trained</li>
          <li class="border border-white/20 px-3 py-1">Insured</li>
          <li class="border border-white/20 px-3 py-1">Fully qualified coach</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <TrialProof heading={p.proofHeading ?? "What Our Members Say"} reviews={p.reviews} stories={p.stories ?? []} />

  <!-- FAQs (anxiety reduction; full FAQ page linked below) -->
  <section class="mx-auto max-w-3xl px-4 pb-14">
    <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tighter mb-6 text-center">Questions</h2>
    <div class="divide-y divide-white/10 border-y border-white/10">
      {p.faqs.map((f) => (
        <details class="group py-4">
          <summary class="flex justify-between items-center cursor-pointer font-bold list-none">
            <span>{f.q}</span>
            <span class="text-brand-red text-xl transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-white/70 leading-relaxed" set:html={f.a}></p>
        </details>
      ))}
    </div>
    <p class="text-center text-white/60 text-sm mt-6">More questions? <a href="/faq" class="text-brand-red underline hover:text-white">See all our FAQs</a></p>
  </section>

  <!-- BACK TO BOOKING -->
  <section class="text-center pb-16 px-4">
    <a href="#book" class="inline-flex items-center gap-2 bg-brand-red hover:bg-red-700 px-8 py-4 font-black uppercase tracking-widest text-sm transition-transform hover:scale-105">
      Pick Your Class Time <span aria-hidden="true">&uarr;</span>
    </a>
    {p.kids && (
      <p class="text-white/50 text-sm mt-8">
        Your child's safety is our first priority. Read our
        <a href="/child-protection-policy" target="_blank" rel="noopener" class="underline hover:text-white">Child Protection Policy</a>.
      </p>
    )}
  </section>
</Layout>
