---
// Social proof block for the hidden /free-trial/* landing pages (G2a design pass, 23 Sep 2026).
// Video stories reuse the same studentStories + click-to-play pattern as the home page.
interface Review { name: string; text: string }
interface Story { quote: string; name: string; detail: string; youtubeId: string }
interface Props {
  heading: string;
  reviews: Review[];
  stories?: Story[];
}
const { heading, reviews, stories = [] } = Astro.props;
---
<section class="mx-auto max-w-5xl px-4 py-16">
  <p class="text-brand-red font-bold tracking-[0.3em] uppercase text-xs mb-3 text-center">Real Members, Real Reviews</p>
  <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tighter mb-10 text-center">{heading}</h2>

  {stories.length > 0 && (
    <div class="flex flex-wrap justify-center gap-5 mb-10">
      {stories.map((s) => (
        <div
          class="trial-video group relative w-[200px] md:w-[230px] aspect-[9/16] rounded-xl overflow-hidden bg-black cursor-pointer ring-1 ring-white/10"
          data-video-id={s.youtubeId}
          role="button"
          tabindex="0"
          aria-label={`Play ${s.name}'s video`}
        >
          <img src={`https://img.youtube.com/vi/${s.youtubeId}/hqdefault.jpg`} alt={`${s.name} video thumbnail`} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/10 to-black/85"></div>
          <span class="absolute inset-0 flex items-center justify-center">
            <span class="w-14 h-14 rounded-full bg-brand-red/90 flex items-center justify-center group-hover:scale-110 transition-transform">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"></path></svg>
            </span>
          </span>
          <p class="absolute top-4 left-4 right-4 font-bold text-white text-sm leading-snug drop-shadow">&ldquo;{s.quote}&rdquo;</p>
          <div class="absolute bottom-4 left-4 right-4">
            <p class="text-brand-red font-black text-sm">{s.name}</p>
            <p class="text-xs text-white/70">{s.detail}</p>
          </div>
        </div>
      ))}
    </div>
  )}

  <div class="grid md:grid-cols-2 gap-6">
    {reviews.map((r) => (
      <figure class="relative bg-white/[0.03] border border-white/10 border-l-4 border-l-brand-red p-8">
        <span class="absolute -top-4 left-6 text-6xl leading-none font-black text-brand-red select-none" aria-hidden="true">&ldquo;</span>
        <blockquote class="text-white/85 text-lg leading-relaxed mb-5">{r.text}</blockquote>
        <figcaption class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-full bg-brand-red flex items-center justify-center font-black text-sm">{r.name.charAt(0)}</span>
          <span>
            <span class="block font-bold uppercase tracking-wide text-sm">{r.name}</span>
            <span class="block text-white/40 text-xs uppercase tracking-widest">Google Review</span>
          </span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll(".trial-video").forEach((card) => {
    const play = () => {
      const id = card.getAttribute("data-video-id");
      if (!id || card.querySelector("iframe")) return;
      card.innerHTML = `<iframe src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0&playsinline=1" class="absolute inset-0 w-full h-full" style="border:0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    };
    card.addEventListener("click", play);
    card.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === "Enter" || k === " ") { e.preventDefault(); play(); }
    });
  });
</script>
