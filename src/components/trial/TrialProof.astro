---
// Google-style review carousel for the hidden /free-trial/* booking pages (Jon, Thu 24 Sep 2026).
// Sits directly under the booking widget. Shows ONLY the 3 verbatim Google reviews Jon supplied for
// each audience (data/testimonials.ts). Horizontally scrollable (swipe on mobile, arrows on desktop).
// Cards are styled like Google reviews: white card, coloured initial avatar, yellow stars, "G" badge.
// Rating line = the real figure (Jon, 23 Sep 2026): 5.0 from 216 Google reviews. Update as it grows.
// (File name kept from the old "TrialProof" block; the video stories were removed on 24 Sep.)
interface Review { name: string; text: string }
interface Props { reviews: Review[] }
const { reviews } = Astro.props;
const avatarColours = ["#1a73e8", "#e8710a", "#188038", "#a142f4", "#d93025"];
---
<section class="py-12 border-t border-white/10" aria-labelledby="trial-reviews-heading">
  <div class="mx-auto max-w-5xl px-4">
    <h2 id="trial-reviews-heading" class="text-center mb-8">
      <span class="block text-[#FBBC04] text-2xl tracking-wider" aria-hidden="true">★★★★★</span>
      <span class="block mt-1 text-xl md:text-2xl font-black uppercase tracking-tight">5.0 from 216 Google reviews</span>
    </h2>

    <div class="relative">
      <div
        class="trial-reviews flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mx-4 px-4"
        style="scrollbar-width: none;"
        tabindex="0"
        aria-label="Google reviews, scroll sideways for more"
      >
        {reviews.map((r, i) => (
          <figure class="snap-center shrink-0 w-[85%] sm:w-[60%] md:w-[calc(50%-0.5rem)] bg-white text-[#202124] rounded-xl p-6 shadow-lg flex flex-col">
            <figcaption class="flex items-center gap-3 mb-3">
              <span
                class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-white text-lg shrink-0"
                style={`background:${avatarColours[i % avatarColours.length]}`}
                aria-hidden="true"
              >{r.name.charAt(0).toUpperCase()}</span>
              <span class="flex-1 min-w-0">
                <span class="block font-semibold text-[15px] leading-tight truncate">{r.name}</span>
                <span class="block text-xs text-[#5f6368]">Google review</span>
              </span>
              <span
                class="w-7 h-7 rounded-full border border-[#dadce0] flex items-center justify-center font-bold text-[#4285F4] text-sm shrink-0"
                title="Posted on Google"
                aria-label="Posted on Google"
              >G</span>
            </figcaption>
            <p class="text-[#FBBC04] text-lg tracking-wide leading-none mb-3" aria-label="Rated 5 out of 5">★★★★★</p>
            <blockquote class="text-[15px] leading-relaxed text-[#3c4043]">{r.text}</blockquote>
          </figure>
        ))}
      </div>

      <button type="button" class="trial-reviews-prev hidden md:flex absolute -left-5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white text-black shadow-lg items-center justify-center font-black" aria-label="Previous review">&larr;</button>
      <button type="button" class="trial-reviews-next hidden md:flex absolute -right-5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white text-black shadow-lg items-center justify-center font-black" aria-label="Next review">&rarr;</button>
    </div>

    <div class="trial-reviews-dots flex justify-center gap-2 mt-2" aria-hidden="true">
      {reviews.map((_, i) => (
        <span class={`h-2 rounded-full transition-all ${i === 0 ? "w-6 bg-white" : "w-2 bg-white/30"}`}></span>
      ))}
    </div>
    <p class="md:hidden text-center text-white/40 text-xs mt-3">Swipe for more reviews &rarr;</p>
  </div>
</section>

<style>
  .trial-reviews::-webkit-scrollbar { display: none; }
</style>

<script>
  const track = document.querySelector<HTMLElement>(".trial-reviews");
  if (track) {
    const cards = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(document.querySelectorAll<HTMLElement>(".trial-reviews-dots span"));
    const step = () => (cards[0]?.offsetWidth ?? 300) + 16;
    document.querySelector(".trial-reviews-prev")?.addEventListener("click", () => track.scrollBy({ left: -step() }));
    document.querySelector(".trial-reviews-next")?.addEventListener("click", () => track.scrollBy({ left: step() }));
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const idx = max <= 0 ? 0 : Math.round((track.scrollLeft / max) * (cards.length - 1));
      dots.forEach((d, i) => {
        d.className = `h-2 rounded-full transition-all ${i === idx ? "w-6 bg-white" : "w-2 bg-white/30"}`;
      });
    };
    track.addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
  }
</script>
