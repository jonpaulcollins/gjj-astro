---
// Booking section for the hidden /free-trial/* pages.
// Redesign 23 Sep 2026 (research: Memory/research/booking-page-conversion-research.md):
// - Widget sits high on the page (within ~2 phone screens); heading + friction-reducing microcopy.
// - No white box around the widget (Jon, 22 Sep) — widget is styled black/red in GHL.
// - FAQ link directly under the widget (Jon, 23 Sep) → main-site FAQ page.
// - Mobile sticky "Book" bar, hidden while the hero or the widget is on screen.
interface Props {
  calendarId: string; // GHL calendar ID (NOT the widget slug)
  label: string;      // e.g. "Junior BJJ"
}
const { calendarId, label } = Astro.props;
---
<section id="book" class="bg-black pt-12 pb-10 border-t border-white/10 scroll-mt-20">
  <div class="mx-auto max-w-3xl px-4">
    <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tighter mb-3 text-center">Choose Your <span class="text-brand-red">Class Time</span></h2>
    <p class="text-white/70 text-center mb-8 text-sm md:text-base">
      Takes about 60 seconds &middot; Free &middot; No card, no contract
    </p>

    <div class="w-full" style="min-height: 700px;">
      <iframe
        src={`https://api.leadconnectorhq.com/widget/booking/${calendarId}`}
        style="width:100%;height:100%;min-height:700px;border:none;background:transparent;"
        scrolling="no"
        id={`${calendarId}-booking`}
        title={`Book your ${label} free trial`}
      ></iframe>
    </div>
    <script src="https://link.msgsndr.com/js/form_embed.js" is:inline></script>

    <div class="mt-6 text-center space-y-2 text-sm">
      <p class="text-white/60">We'll send your confirmation and a quick registration link straight after you book.</p>
      <p class="text-white/60">
        Questions first? See our <a href="/faq" class="text-brand-red underline hover:text-white">FAQs</a>
        or call / WhatsApp <a href="tel:+447575572021" class="underline hover:text-white">+44 7575 572021</a>
      </p>
    </div>
  </div>
</section>

<!-- Mobile sticky CTA -->
<a
  href="#book"
  id="trial-sticky-cta"
  class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-brand-red text-white text-center font-black uppercase tracking-widest text-sm py-4 shadow-2xl transition-transform duration-300"
  style="transform: translateY(100%)"
>
  Book Your Free Trial
</a>

<script>
  const cta = document.getElementById("trial-sticky-cta");
  const book = document.getElementById("book");
  const hero = document.getElementById("trial-hero");
  if (cta && book && "IntersectionObserver" in window) {
    let bookVisible = false;
    let heroVisible = true;
    const update = () => {
      cta.style.transform = bookVisible || heroVisible ? "translateY(100%)" : "translateY(0)";
    };
    new IntersectionObserver(([e]) => { bookVisible = e.isIntersecting; update(); }, { threshold: 0.05 }).observe(book);
    if (hero) new IntersectionObserver(([e]) => { heroVisible = e.isIntersecting; update(); }).observe(hero);
    update();
  }
</script>
